+    public function exits(Request $request)
+    {
+        $query = Employee::with(['user', 'department', 'position'])
+            ->where('status', 'terminated');
+
+        if ($request->filled('search')) {
+            $search = $request->string('search');
+            $query->where(function ($q) use ($search) {
+                $q->where('employee_number', 'like', "%{$search}%")
+                    ->orWhereHas('user', function ($u) use ($search) {
+                        $u->where('first_name', 'like', "%{$search}%")
+                          ->orWhere('last_name', 'like', "%{$search}%")
+                          ->orWhere('email', 'like', "%{$search}%");
+                    });
+            });
+        }
+
+        if ($request->filled('termination_type')) {
+            $query->where('termination_type', $request->termination_type);
+        }
+
+        return response()->json($query->latest('terminated_at')->paginate($request->integer('per_page', 15)));
+    }
+
+    public function terminate(Request $request, Employee $employee, EmployeeHistoryService $historyService)
+    {
+        $validated = $request->validate([
+            'termination_type' => 'required|in:resignation,dismissal,contract_end,retirement,death,other',
+            'terminated_at' => 'required|date',
+            'termination_reason' => 'nullable|string|max:2000',
+        ]);
+
+        if ($employee->status === 'terminated') {
+            return response()->json(['message' => 'Cet employé est déjà sorti de l’organisation.'], 422);
+        }
+
+        DB::beginTransaction();
+        try {
+            $employee->user->update(['status' => 'inactive']);
+            $employee->update([
+                'status' => 'terminated',
+                'terminated_at' => $validated['terminated_at'],
+                'termination_type' => $validated['termination_type'],
+                'termination_reason' => $validated['termination_reason'] ?? null,
+            ]);
+
+            $employee->contracts()->where('status', 'active')->update([
+                'status' => 'terminated',
+                'termination_reason' => $validated['termination_reason'] ?? 'Sortie de l’employé',
+            ]);
+
+            $historyService->logTermination(
+                $employee,
+                $validated['termination_reason'] ?? 'Sortie de l’employé.'
+            );
+
+            DB::commit();
+
+            return response()->json([
+                'message' => 'Sortie de l’employé enregistrée avec succès',
+                'employee' => $employee->fresh()->load(['user', 'department', 'position']),
+            ]);
+        } catch (\Throwable $e) {
+            DB::rollBack();
+            report($e);
+            return response()->json(['message' => 'Une erreur interne est survenue lors de la sortie.'], 500);
+        }
+    }
+
+    // Compatibilité avec l'ancienne action DELETE : elle devient une sortie
+    // contrôlée, mais l'interface doit désormais privilégier terminate().
+    public function destroy(Employee $employee, EmployeeHistoryService $historyService)
+    {
+        return response()->json([
+            'message' => 'Utilisez l’action de sortie employé avec un motif explicite.'
+        ], 422);
+    }
