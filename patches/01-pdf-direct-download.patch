@@ -0,0 +1,50 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Payroll;
+use Barryvdh\DomPDF\Facade\Pdf;
+use SimpleSoftwareIO\QrCode\Facades\QrCode;
+
+class PayslipPdfService
+{
+    /**
+     * Génère le bulletin de paie en PDF portrait A4, avec QR code de
+     * vérification intégré (pointe vers l'API publique de vérification).
+     */
+    public function generate(Payroll $payroll)
+    {
+        $payroll->load([
+            'employee.user',
+            'employee.department',
+            'employee.position',
+            'tenant',
+        ]);
+
+        $verificationUrl = rtrim(config('app.url'), '/') . '/api/payslips/verify/' . $payroll->qr_token;
+
+        $qrCodeBase64 = base64_encode(
+            QrCode::format('png')
+                ->size(140)
+                ->margin(1)
+                ->generate($verificationUrl)
+        );
+
+        $logoPath = null;
+        if ($payroll->tenant?->logo && \Illuminate\Support\Facades\Storage::disk('public')->exists($payroll->tenant->logo)) {
+            $logoPath = \Illuminate\Support\Facades\Storage::disk('public')->path($payroll->tenant->logo);
+        }
+
+        return Pdf::loadView('pdf.payslip', [
+            'payroll' => $payroll,
+            'qrCodeBase64' => $qrCodeBase64,
+            'verificationUrl' => $verificationUrl,
+            'logoPath' => $logoPath,
+        ])
+            ->setPaper('a4', 'portrait')
+            ->setOptions([
+                'isRemoteEnabled' => true,
+                'defaultFont' => 'DejaVu Sans',
+            ]);
+    }
+}
