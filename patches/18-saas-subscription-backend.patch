--- a/app/Models/Tenant.php
+++ b/app/Models/Tenant.php
@@ -111,4 +111,37 @@ public function getPayslipHeaderNameAttribute(): string
     {
         return $this->emitting_authority ?: $this->name;
     }
+
+    /**
+     * Nombre maximal de sièges employés autorisés par le plan en
+     * cours, ou null si aucune limite ne s'applique (plan entreprise
+     * ou plan inconnu — on ne bloque jamais par excès de prudence).
+     */
+    public function seatLimit(): ?int
+    {
+        $features = $this->current_subscription?->features;
+
+        if (is_array($features) && array_key_exists('employee_limit_max', $features)) {
+            return $features['employee_limit_max'];
+        }
+
+        foreach (config('sds_rh.plans') as $plan) {
+            if ($plan['db_name'] === $this->subscription_plan) {
+                return $plan['max'] === PHP_INT_MAX ? null : $plan['max'];
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * Sièges employés occupés : tout employé qui n'est pas
+     * définitivement sorti de l'organisation compte pour un siège.
+     */
+    public function occupiedSeats(): int
+    {
+        return $this->employees()
+            ->whereIn('status', ['active', 'on_leave', 'suspended'])
+            ->count();
+    }
 }
