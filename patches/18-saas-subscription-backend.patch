+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use Carbon\Carbon;
+
+class SubscriptionController extends Controller
+{
+    public function show()
+    {
+        $tenant = app('tenant');
+        $subscription = $tenant->current_subscription;
+
+        $seatLimit = $tenant->seatLimit();
+        $occupiedSeats = $tenant->occupiedSeats();
+
+        $daysRemaining = $tenant->subscription_expires_at
+            ? (int) Carbon::now()->diffInDays($tenant->subscription_expires_at, false)
+            : null;
+
+        return response()->json([
+            'tenant' => [
+                'name' => $tenant->name,
+                'is_active' => $tenant->is_active,
+                'subscription_plan' => $tenant->subscription_plan,
+                'subscription_expires_at' => $tenant->subscription_expires_at,
+            ],
+            'subscription' => $subscription ? [
+                'plan' => $subscription->plan,
+                'price' => $subscription->price,
+                'currency' => $subscription->currency,
+                'billing_cycle' => $subscription->billing_cycle,
+                'start_date' => $subscription->start_date,
+                'end_date' => $subscription->end_date,
+                'status' => $subscription->status,
+                'payment_method' => $subscription->payment_method,
+                'is_active' => $subscription->isActive(),
+            ] : null,
+            'usage' => [
+                'employees_used' => $occupiedSeats,
+                'employees_limit' => $seatLimit,
+                'seats_available' => $seatLimit === null ? null : max(0, $seatLimit - $occupiedSeats),
+                'is_at_limit' => $seatLimit !== null && $occupiedSeats >= $seatLimit,
+            ],
+            'days_remaining' => $daysRemaining,
+            'is_trial' => (bool) ($subscription?->features['trial'] ?? false),
+        ]);
+    }
+}
