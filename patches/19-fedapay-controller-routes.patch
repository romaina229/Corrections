+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Services\FedaPayService;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class PaymentController extends Controller
+{
+    public function checkout(Request $request, FedaPayService $fedaPay)
+    {
+        $data = $request->validate([
+            'plan' => 'required|string|in:starter,standard,business',
+            'billing_cycle' => 'required|in:monthly,yearly',
+        ]);
+
+        $tenant = app('tenant');
+
+        $callbackUrl = rtrim((string) env('FRONTEND_URL', config('app.url')), '/') . '/subscription/callback';
+
+        $payment = $fedaPay->createCheckout($tenant, $data['plan'], $data['billing_cycle'], $callbackUrl);
+
+        return response()->json([
+            'checkout_url' => $payment->checkout_url,
+            'payment_id' => $payment->id,
+        ]);
+    }
+
+    /**
+     * Endpoint public (hors auth:sanctum et hors middleware tenant) —
+     * FedaPay ne porte aucune session utilisateur lors de l'appel.
+     * La sécurité repose entièrement sur la vérification de signature.
+     */
+    public function webhook(Request $request, FedaPayService $fedaPay)
+    {
+        $payload = $request->getContent();
+        $signature = $request->header('X-FEDAPAY-SIGNATURE');
+
+        if (! $signature) {
+            return response()->json(['message' => 'Signature manquante'], 400);
+        }
+
+        try {
+            $event = $fedaPay->verifyWebhookSignature($payload, $signature);
+        } catch (\Throwable $e) {
+            Log::warning('Webhook FedaPay rejeté : signature invalide', ['error' => $e->getMessage()]);
+
+            return response()->json(['message' => 'Signature invalide'], 400);
+        }
+
+        try {
+            $fedaPay->handleEvent($event);
+        } catch (\Throwable $e) {
+            // On répond tout de même 200 pour éviter des retries en
+            // boucle sur une erreur de notre côté déjà loguée ;
+            // l'événement reste consultable depuis le dashboard FedaPay
+            // pour un renvoi manuel si nécessaire.
+            report($e);
+        }
+
+        return response()->json(['received' => true]);
+    }
+}
