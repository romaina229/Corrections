+<?php
+
+namespace App\Services;
+
+use Barryvdh\DomPDF\Facade\Pdf;
+use PhpOffice\PhpSpreadsheet\Spreadsheet;
+use PhpOffice\PhpSpreadsheet\Writer\Xlsx;
+use Symfony\Component\HttpFoundation\StreamedResponse;
+
+class ReportExportService
+{
+    /**
+     * Génère un rapport PDF portrait A4 générique : titre, période,
+     * bloc de résumé (paires clé/valeur) puis tableau de détail.
+     *
+     * @param  array<string, string|int|float>  $summary
+     * @param  array<int, string>  $headers
+     * @param  array<int, array<int, string>>  $rows
+     */
+    public function generatePdf(string $title, string $periodLabel, array $summary, array $headers, array $rows)
+    {
+        return Pdf::loadView('pdf.report', [
+            'title' => $title,
+            'periodLabel' => $periodLabel,
+            'summary' => $summary,
+            'headers' => $headers,
+            'rows' => $rows,
+        ])
+            ->setPaper('a4', 'landscape')
+            ->setOptions([
+                'isRemoteEnabled' => false,
+                'defaultFont' => 'DejaVu Sans',
+            ]);
+    }
+
+    /**
+     * Génère un classeur Excel (.xlsx) réel : une feuille « Résumé »
+     * (si un résumé est fourni) et une feuille « Détail » avec
+     * en-têtes figés et largeurs de colonnes auto-ajustées.
+     *
+     * @param  array<string, string|int|float>  $summary
+     * @param  array<int, string>  $headers
+     * @param  array<int, array<int, string>>  $rows
+     */
+    public function generateExcel(string $title, string $periodLabel, array $summary, array $headers, array $rows, string $filename = 'rapport.xlsx'): StreamedResponse
+    {
+        $spreadsheet = new Spreadsheet();
+
+        if (! empty($summary)) {
+            $summarySheet = $spreadsheet->getActiveSheet();
+            $summarySheet->setTitle('Résumé');
+            $summarySheet->setCellValue('A1', $title);
+            $summarySheet->setCellValue('A2', $periodLabel);
+            $summarySheet->getStyle('A1')->getFont()->setBold(true)->setSize(14);
+
+            $row = 4;
+            foreach ($summary as $label => $value) {
+                $summarySheet->setCellValue('A' . $row, $label);
+                $summarySheet->setCellValue('B' . $row, $value);
+                $row++;
+            }
+            $summarySheet->getColumnDimension('A')->setWidth(35);
+            $summarySheet->getColumnDimension('B')->setWidth(20);
+
+            $detailSheet = $spreadsheet->createSheet();
+        } else {
+            $detailSheet = $spreadsheet->getActiveSheet();
+        }
+
+        $detailSheet->setTitle('Détail');
+        foreach ($headers as $index => $header) {
+            $detailSheet->setCellValueByColumnAndRow($index + 1, 1, $header);
+        }
+        $detailSheet->getStyle(1, 1, count($headers), 1)->getFont()->setBold(true);
+        $detailSheet->freezePane('A2');
+
+        foreach ($rows as $rowIndex => $rowData) {
+            foreach ($rowData as $colIndex => $value) {
+                $detailSheet->setCellValueByColumnAndRow($colIndex + 1, $rowIndex + 2, $value);
+            }
+        }
+
+        foreach (range(1, count($headers)) as $col) {
+            $detailSheet->getColumnDimensionByColumn($col)->setAutoSize(true);
+        }
+
+        $spreadsheet->setActiveSheetIndex(0);
+
+        $writer = new Xlsx($spreadsheet);
+
+        return new StreamedResponse(function () use ($writer) {
+            $writer->save('php://output');
+        }, 200, [
+            'Content-Type' => 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
+            'Content-Disposition' => 'attachment; filename="' . $filename . '"',
+            'Cache-Control' => 'max-age=0',
+        ]);
+    }
+}
