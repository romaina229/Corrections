+    private function export(ReportExportService $exportService, string $format, string $title, string $periodLabel, array $summary, array $headers, array $rows)
+    {
+        $filename = str($title)->slug('-') . '-' . now()->format('Y-m-d');
+
+        if ($format === 'excel') {
+            return $exportService->generateExcel($title, $periodLabel, $summary, $headers, $rows, $filename . '.xlsx');
+        }
+
+        return $exportService->generatePdf($title, $periodLabel, $summary, $headers, $rows)
+            ->download($filename . '.pdf');
+    }
