+        $employee = $this->currentEmployee($request);
+
+        abort_unless((int) $payroll->employee_id === (int) $employee->id, 403, 'Accès à ce bulletin interdit.');
+
+        $pdf = $pdfService->generate($payroll);
+        $employeeName = str($employee->full_name ?: 'employe')->slug('-');
+        $filename = 'bulletin-de-paie-' . $employeeName . '-' . $payroll->month . '.pdf';
+
+        return $pdf->download($filename);
+    }
